{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true
  }
}
